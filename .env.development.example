NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://atas:atas@localhost:5432/atas
DATABASE_POOL_MAX=10
JWT_SECRET=development-only-secret-change-me-now
JWT_ISSUER=atas.local
JWT_AUDIENCE=atas-api
JWT_REQUIRE_MATCH_SCOPE=false
AUDIT_HMAC_SECRET=development-audit-secret-change-me-now
AUTH_DISABLED=true
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY=false
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1 minute
CLOCK_RATE_LIMIT_MAX=6000
BODY_LIMIT_BYTES=1048576
RULESET_PATH=rulesets/ifab-2026-27.json
PRIMARY_CLOCK_SOURCE=development-user
CLOCK_SOURCE_SUBJECTS=development-user
CLOCK_MAX_SAMPLE_AGE_MS=5000
CLOCK_FUTURE_TOLERANCE_US=2000000
CLOCK_MAX_ADVANCE_SKEW_US=2000000
CLOCK_MINIMUM_FRESH_SOURCES=1
CLOCK_MAX_SOURCE_DRIFT_US=100000
CLOCK_MAX_WALL_DRIFT_US=2000000
OUTBOX_RETENTION_DAYS=30
OUTBOX_CLEANUP_INTERVAL_MS=3600000
OUTBOX_CLEANUP_BATCH_SIZE=10000
REALTIME_LISTENER_HEARTBEAT_MS=5000
REALTIME_LISTENER_MAX_STALE_MS=15000
SHUTDOWN_TIMEOUT_MS=15000
PUBLIC_CONSOLE=true
