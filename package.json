{
  "name": "atas-added-time-assistance-system",
  "version": "1.3.0",
  "private": false,
  "description": "Auditable real-time added-time assistance reference system for football officiating.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "José Francisco Bustamante Ocampo and ATAS contributors",
  "keywords": [
    "football",
    "soccer",
    "officiating",
    "added-time",
    "event-sourcing",
    "audit",
    "realtime"
  ],
  "homepage": "https://github.com/LiliumFra/ATAS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiliumFra/ATAS.git"
  },
  "bugs": {
    "url": "https://github.com/LiliumFra/ATAS/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "token:issue": "tsx scripts/issue-token.ts",
    "audit:verify": "tsx scripts/verify-audit.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "audit:checkpoint": "tsx scripts/export-checkpoint.ts",
    "audit:checkpoint:verify": "tsx scripts/verify-checkpoint.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/jwt": "10.2.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "10.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "@fastify/websocket": "11.3.0",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.10.0",
    "jose": "6.2.3",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "@types/ws": "8.18.1",
    "@eslint/js": "10.0.1"
  }
}
